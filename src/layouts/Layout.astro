---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = '日本語 クイズ' } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Repaso interactivo de japonés: gramática, vocabulario y conjugación de verbos." />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar, para evitar flash. Default: dark.
      (() => {
        try {
          document.documentElement.setAttribute(
            'data-theme',
            localStorage.getItem('nihongo-theme') || 'dark',
          );
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
